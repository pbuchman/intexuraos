rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 💰 CostGuard: Prevent unlimited queries, enforce userId filtering
    match /actions/{actionId} {
      allow get: if isOwner(resource.data.userId);

      // 💰 CostGuard: Query limit max 100 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 100
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only)
      allow write: if false;
    }

    // Research documents for real-time status updates
    match /researches/{researchId} {
      allow get: if isOwner(resource.data.userId);

      // 💰 CostGuard: Query limit max 100 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 100
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only)
      allow write: if false;
    }

    // Commands for real-time inbox updates
    match /commands/{commandId} {
      allow get: if isOwner(resource.data.userId);

      // 💰 CostGuard: Query limit max 100 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 100
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only)
      allow write: if false;
    }

    // User-scoped notes
    match /notes/{noteId} {
      allow get: if isOwner(resource.data.userId);

      // 💰 CostGuard: Query limit max 100 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 100
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only via API)
      allow write: if false;
    }

    // Code tasks for real-time status updates
    match /code_tasks/{taskId} {
      allow get: if isOwner(resource.data.userId);

      // 💰 CostGuard: Query limit max 100 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 100
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only)
      allow write: if false;
    }

    // Logs subcollection for real-time execution logs
    match /code_tasks/{taskId}/logs/{logId} {
      allow read, write: if isAuthenticated()
                    && get(/databases/$(database)/documents/code_tasks/$(taskId)).data.userId == request.auth.uid;
    }

    // Log entries subcollection for structured execution logs
    match /code_tasks/{taskId}/log_entries/{entryId} {
      allow read, write: if isAuthenticated()
                  && get(/databases/$(database)/documents/code_tasks/$(taskId)).data.userId == request.auth.uid;
    }

    // Log lines subcollection for formatted execution logs
    match /code_tasks/{taskId}/log_lines/{lineId} {
      allow read, write: if isAuthenticated()
                  && get(/databases/$(database)/documents/code_tasks/$(taskId)).data.userId == request.auth.uid;
    }

    // GitHub event log entries for real-time webhook feed
    match /github-event-log-entries/{entryId} {
      allow get: if isAuthenticated();

      // 💰 CostGuard: Query limit max 100 docs (matches LIVE_QUERY_LIMIT)
      allow list: if isAuthenticated()
                  && request.query.limit <= 100;

      // Client cannot write (backend-only via webhook handler)
      allow write: if false;
    }

    // PR automation comment tracking for unified PR log
    match /pr_automation_comments/{commentId} {
      allow get: if isAuthenticated();

      // CostGuard: Query limit max 50 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 50;

      // Client cannot write (backend-only via webhook handler)
      allow write: if false;
    }

    // Canonical execution memories for code-agent retrieval
    match /execution_memories/{memoryId} {
      allow read, write: if false;
    }

    // Execution memory retrieval/application audit records
    match /execution_memory_applications/{applicationId} {
      allow read, write: if false;
    }

    // User-visible code task dispatch blocker system statuses
    match /code_task_system_statuses/{statusId} {
      allow get: if isOwner(resource.data.userId);

      // CostGuard: Query limit max 50 docs
      allow list: if isAuthenticated()
                  && request.query.limit <= 50
                  && resource.data.userId == request.auth.uid;

      // Client cannot write (backend-only)
      allow write: if false;
    }

    // All other collections blocked from client
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
