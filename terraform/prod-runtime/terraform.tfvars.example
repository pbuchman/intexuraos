# IntexuraOS production runtime Terraform variables.
# Production non-secret defaults are committed in prod.auto.tfvars.json.
# Copy this file to terraform.tfvars only for local, uncommitted overrides.
# DO NOT commit terraform.tfvars.

project_id         = "intexuraos-dev-pbuchman"
region             = "europe-central2"
environment        = "prod"
source_environment = "dev"
hetzner_origin     = "https://intexuraos.cloud"

# Historical compatibility pin. Filters are immutable, so this must stay true.
activate_hetzner_async_consumers = true

# Safe defaults. Select reviewed keys only after full-profile runtime, backlog
# policy and monitoring readiness; the master switch overrides every selection.
production_scheduler_jobs_enabled = false
production_scheduler_enabled_job_keys = []
production_pubsub_push_enabled_subscription_keys = []

labels = {}
