# Copy to terraform.tfvars and fill in values.
# DO NOT commit terraform.tfvars — it is excluded by .gitignore.

project_id = "intexuraos-dev-pbuchman"
# region defaults to europe-central2

# Public SSH key for deploy user on the VM.
# Generated in Phase 0.2: ~/.ssh/intexuraos_hetzner_deploy.pub
# Example: "ssh-ed25519 AAAA... intexuraos-hetzner-deploy"
deploy_ssh_public_key = "ssh-ed25519 AAAA... intexuraos-hetzner-deploy"

# NOTE: SSH (port 22) is open to the world in the firewall.
# Security relies on:
#   - SSH key-only auth (PasswordAuthentication no)
#   - AllowUsers deploy (only the deploy user can log in)
#   - AuthenticationMethods publickey (no other methods accepted)
# See scripts/hetzner/provision.sh for the hardened sshd_config.
