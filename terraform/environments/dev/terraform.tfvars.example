# IntexuraOS Dev Environment Terraform Variables
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to version control.

# GCP Project ID (required)
project_id = "your-gcp-project-id"

# GCP Region (default: europe-central2)
region = "europe-central2"

# Environment name
environment = "dev"

# Phase A removes legacy readers while retaining every legacy container.
# Phase B may set both false only after the seven-day reversible soak passes.

# Exact GitHub repository identity accepted by Workload Identity Federation
github_owner               = "pbuchman"
github_repository_owner_id = "368465"

# GitHub repository name
github_repo          = "intexuraos"
github_repository_id = "1118959310"

# Exact Git ref accepted by Workload Identity Federation
github_ref = "refs/heads/development"

# GitHub branch to trigger builds
github_branch = "development"

# Cloud Build GitHub connection name
github_connection_name = "github-pbuchman"

# Keep retired Cloud Run-targeted Pub/Sub pushes disabled.
# Hetzner-owned subscriptions and Scheduler jobs live in terraform/hetzner-prod.
enable_legacy_cloud_run_async_consumers = false

# Enable LLM API audit logging (logs all LLM calls to Firestore)
audit_llms = true

# Email address for monitoring alerts (set to null/omit to disable email alerts)
# alert_email = "ops@example.com"

# Slack notification channel (optional)
#   slack_auth_token   — Slack bot OAuth token (xoxb-...) with chat:write scope.
#                        Leave commented to skip Slack channel provisioning.
#   slack_channel_name — Slack channel for alerts (default "#alerts").
# slack_auth_token   = "xoxb-REPLACE_ME"
# slack_channel_name = "#alerts"
