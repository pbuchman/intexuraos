# IntexuraOS Hetzner production Terraform variables.
# Production non-secret defaults are committed in prod.auto.tfvars.json.
# Copy this file to terraform.tfvars only for local, uncommitted overrides.
# DO NOT commit terraform.tfvars.

project_id  = "intexuraos-dev-pbuchman"
region      = "europe-central2"
environment = "prod"
domain      = "intexuraos.cloud"

# Migration-safe defaults. Set false only after package rollback proof and at
# least 72 hours of healthy observation.

activate_hetzner_async_consumers = true
# Set true only for the one-time guarded cleanup documented in the runbook.
enable_retired_async_consumer_cleanup = false

hetzner_location    = "nbg1"
hetzner_server_type = "cx33"
hetzner_image       = "ubuntu-24.04"

# Generate with:
# ssh-keygen -t ed25519 -C "intexuraos-hetzner-deploy" -f ~/.ssh/intexuraos_hetzner_deploy
deploy_ssh_public_key = "ssh-ed25519 AAAA_REPLACE_ME intexuraos-hetzner-deploy"

# Terraform uses these local secret files only during VM bootstrap. They are not
# committed; keep them in a secure operator profile.
deploy_ssh_private_key_path = "~/.ssh/intexuraos_hetzner_deploy"
provisioner_sa_key_path     = "~/.config/intexuraos/hetzner/provisioner-sa-key.json"
prod_secret_package_version = 1
hetzner_bootstrap_enabled   = true

# Production currently allows broad SSH CIDRs and relies on hardened key-only
# sshd on the VM. Narrow this list to operator /32 ranges when remote access is
# stable through an alternate path.
admin_ssh_source_ips = ["0.0.0.0/0", "::/0"]

web_source_ips = ["0.0.0.0/0", "::/0"]
