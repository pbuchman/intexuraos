# IntexuraOS Hetzner production Terraform variables.
# Copy to terraform.tfvars and fill in operator-specific values.
# DO NOT commit terraform.tfvars.

project_id  = "intexuraos-dev-pbuchman"
region      = "europe-central2"
environment = "prod-hetzner"
domain      = "intexuraos.cloud"

hetzner_location    = "nbg1"
hetzner_server_type = "cx32"
hetzner_image       = "ubuntu-24.04"

# Generate with:
# ssh-keygen -t ed25519 -C "intexuraos-hetzner-deploy" -f ~/.ssh/intexuraos_hetzner_deploy
deploy_ssh_public_key = "ssh-ed25519 AAAA_REPLACE_ME intexuraos-hetzner-deploy"

# Replace with the operator's current public IP as a /32.
# Broad ranges such as 0.0.0.0/0 and ::/0 are rejected by validation.
admin_ssh_source_ips = ["203.0.113.10/32"]

web_source_ips = ["0.0.0.0/0", "::/0"]

cloudflare_dns_api_token_secret_id = "INTEXURAOS_CLOUDFLARE_DNS_API_TOKEN"
