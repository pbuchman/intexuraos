<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for IntexuraOS container cleanup.
  Runs as the current user (required for Docker Desktop access on macOS).

  Installation:
    1. Copy this file to ~/Library/LaunchAgents/
    2. Edit ProgramArguments[1] to the absolute path of cleanup-containers.sh
    3. Load:  launchctl load ~/Library/LaunchAgents/cloud.intexuraos.container-cleanup.plist
    4. Verify: launchctl list | grep intexuraos

  The job runs every 6 hours (21600 seconds).
  Logs default to /tmp/ — see the NOTE at the bottom to switch to a
  persistent location (recommended: ~/Library/Logs/intexuraos/).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.intexuraos.container-cleanup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/Shared/intexuraos/workers/scripts/cleanup-containers.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CONTAINER_PREFIX</key>
    <string>claude-worker-</string>
    <key>RETENTION_DAYS</key>
    <string>1</string>
    <key>LOG_FILE</key>
    <string>/tmp/intexuraos-container-cleanup.log</string>
  </dict>

  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/intexuraos-container-cleanup-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/intexuraos-container-cleanup-stderr.log</string>

  <!-- NOTE: For persistent logging, change LOG_FILE above to
       ~/Library/Logs/intexuraos/container-cleanup.log and create
       the directory: mkdir -p ~/Library/Logs/intexuraos -->
</dict>
</plist>
