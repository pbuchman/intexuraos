# systemd timer unit — triggers container-cleanup.service every 6 hours.
#
# Installation: see container-cleanup.service header.
#
# Check timer status:
#   systemctl list-timers container-cleanup.timer

[Unit]
Description=Run IntexuraOS container cleanup every 6 hours

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
