{
  "name": "@intexuraos/orchestrator",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-service.mjs orchestrator",
    "typecheck": "tsc --noEmit",
    "lint:local": "eslint src --max-warnings 0",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "verify:error-hub-mcp": "node scripts/verify-error-hub-mcp.mjs",
    "test": "vitest run --exclude '**/e2e*.test.ts'",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@fastify/cors": "^10.1.0",
    "@google-cloud/firestore": "catalog:",
    "@google/genai": "^1.0.0",
    "@sentry/node": "^8.42.0",
    "@intexuraos/code-task-domain": "workspace:*",
    "@intexuraos/common-core": "workspace:*",
    "@intexuraos/infra-sentry": "workspace:*",
    "@intexuraos/linear-domain": "workspace:*",
    "@intexuraos/llm-contract": "workspace:*",
    "@intexuraos/llm-factory": "workspace:*",
    "@intexuraos/llm-pricing": "workspace:*",
    "@intexuraos/llm-utils": "workspace:*",
    "@intexuraos/infra-openrouter": "workspace:*",
    "@octokit/core": "^6.1.0",
    "@octokit/plugin-retry": "^7.1.0",
    "async-mutex": "^0.5.0",
    "dockerode": "^4.0.9",
    "fastify": "catalog:",
    "fastify-server": "0.0.1-alpha.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "minimatch": "^10.1.1",
    "openai": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "memfs": "^4.56.11",
    "nock": "^13.5.5",
    "typescript": "^5.7.3",
    "vitest": "^4.0.16"
  }
}
