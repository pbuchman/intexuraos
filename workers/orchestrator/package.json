{
  "name": "@intexuraos/orchestrator",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-service.mjs orchestrator",
    "typecheck": "tsc --noEmit",
    "lint:local": "eslint src --max-warnings 0",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --exclude '**/e2e*.test.ts'",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@intexuraos/common-core": "workspace:*",
    "async-mutex": "^0.5.0",
    "dockerode": "^4.0.9",
    "fastify": "^5.6.2",
    "fastify-server": "0.0.1-alpha.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "minimatch": "^10.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "nock": "^13.5.5",
    "typescript": "^5.7.3",
    "vitest": "^4.0.16"
  }
}
