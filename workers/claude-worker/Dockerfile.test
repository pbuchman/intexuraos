# ==============================================================================
# Claude Worker Test Image
# ==============================================================================
# Uses a stub script instead of real Claude CLI for E2E testing.
# This allows testing container behavior without API calls.

FROM node:22-alpine

# Install tools matching production image for accurate E2E testing
RUN apk add --no-cache \
    git \
    openssh-client \
    curl \
    bash \
    jq \
    && rm -rf /var/cache/apk/*

# Install ripgrep, fd, bat, github-cli from edge/community
RUN apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    ripgrep \
    fd \
    bat \
    github-cli

# Create gh wrapper that reads fresh token from file on every invocation.
# Mirrors production Dockerfile — /usr/local/bin/gh shadows /usr/bin/gh.
RUN printf '#!/bin/sh\nif [ -f "/secrets/github-token" ]; then\n  export GITHUB_TOKEN="$(cat /secrets/github-token)"\n  export GH_TOKEN="$GITHUB_TOKEN"\nfi\nexec /usr/bin/gh "$@"\n' > /usr/local/bin/gh \
    && chmod +x /usr/local/bin/gh

# Install pnpm (required for CI commands in tests)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Create non-root user (use UID 1001 matching production image)
RUN addgroup -S claude && adduser -S claude -G claude -u 1001

# Set up directories
RUN mkdir -p /repo /secrets /tmp /home/claude/.claude \
    && chown -R claude:claude /repo /secrets /tmp /home/claude

# Copy claude stub instead of installing real Claude CLI
COPY test-fixtures/claude-stub.sh /usr/local/bin/claude
RUN chmod +x /usr/local/bin/claude

# Bake Claude default config to skip onboarding (same as production)
COPY --chown=claude:claude config-defaults/claude.json /opt/claude-defaults/.claude.json

# Copy entrypoint (same as production)
COPY --chown=claude:claude entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Security: Remove unnecessary tools
RUN rm -f /usr/bin/wget /usr/bin/nc 2>/dev/null || true

# Set environment
ENV HOME=/home/claude
ENV NODE_ENV=test
ENV GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# Switch to non-root user
USER claude
WORKDIR /repo

ENTRYPOINT ["/entrypoint.sh"]
