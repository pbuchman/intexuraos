# IntexuraOS Local Development Overrides
#
# Copy this file to .envrc.local and uncomment what you need.
# This file overrides values from .envrc (synced from Secret Manager).
#
# Usage:
#   cp .envrc.local.example .envrc.local
#   ./scripts/sync-secrets.sh
#   direnv allow
#   pnpm run dev

# =============================================================================
# FIREBASE EMULATORS (local macOS only — dev machine uses real GCP)
# =============================================================================
# Default: false. The dev machine does NOT run Firebase Auth/Firestore emulators
# (only Pub/Sub emulator on 8102/8105), so this must stay false there.
# Set to 'true' ONLY on local macOS where Firebase emulators are running.
export INTEXURAOS_USE_FIREBASE_EMULATORS=false

# =============================================================================
# AUTH (backend services require non-prefixed names)
# =============================================================================
# The fastifyAuthPlugin expects AUTH_* without INTEXURAOS_ prefix.
# Map from the prefixed versions loaded from Secret Manager.

export AUTH_JWKS_URL=$INTEXURAOS_AUTH_JWKS_URL
export AUTH_ISSUER=$INTEXURAOS_AUTH_ISSUER
export AUTH_AUDIENCE=$INTEXURAOS_AUTH_AUDIENCE

# =============================================================================
# SERVICE URLS (override run.app -> localhost)
# =============================================================================
# Override cloud-deployed services with locally running instances.
# Uncomment services you're running locally via 'pnpm run dev'.

export INTEXURAOS_USER_SERVICE_URL=http://localhost:8110
export INTEXURAOS_NOTION_SERVICE_URL=http://localhost:8112
export INTEXURAOS_WHATSAPP_SERVICE_URL=http://localhost:8113
export INTEXURAOS_MOBILE_NOTIFICATIONS_SERVICE_URL=http://localhost:8114
export INTEXURAOS_RESEARCH_AGENT_URL=http://localhost:8116
export INTEXURAOS_COMMANDS_AGENT_URL=http://localhost:8117
export INTEXURAOS_ACTIONS_AGENT_URL=http://localhost:8118
export INTEXURAOS_DATA_INSIGHTS_AGENT_URL=http://localhost:8119
export INTEXURAOS_IMAGE_SERVICE_URL=http://localhost:8120
export INTEXURAOS_NOTES_AGENT_URL=http://localhost:8121
export INTEXURAOS_APP_SETTINGS_SERVICE_URL=http://localhost:8122
export INTEXURAOS_TODOS_AGENT_URL=http://localhost:8123
export INTEXURAOS_BOOKMARKS_AGENT_URL=http://localhost:8124
export INTEXURAOS_CALENDAR_AGENT_URL=http://localhost:8125
export INTEXURAOS_LINEAR_AGENT_URL=http://localhost:8126

# =============================================================================
# GCS BUCKETS
# =============================================================================
# Required for media storage (uses real GCP buckets)
export INTEXURAOS_WHATSAPP_MEDIA_BUCKET=intexuraos-whatsapp-media
export INTEXURAOS_IMAGE_BUCKET=intexuraos-images

# =============================================================================
# PUB/SUB (local emulator — required for local dev)
# =============================================================================
# Pub/Sub uses a local emulator to avoid topic conflicts between environments.
# Start with: pnpm run emulators:start
# The pubsub-ui container bridges emulator messages to local service endpoints.

# Required by whatsapp-service for media cleanup events
export INTEXURAOS_PUBSUB_MEDIA_CLEANUP_TOPIC=media-cleanup
export INTEXURAOS_PUBSUB_MEDIA_CLEANUP_SUBSCRIPTION=media-cleanup-sub

# Required for WhatsApp message sending via Pub/Sub
# research-agent publishes, whatsapp-service subscribes
export INTEXURAOS_PUBSUB_WHATSAPP_SEND_TOPIC=whatsapp-send-message
export INTEXURAOS_PUBSUB_WHATSAPP_SEND_SUBSCRIPTION=whatsapp-send-message-sub

# Required for todos processing (todos-agent publishes and subscribes)
export INTEXURAOS_TODOS_PROCESSING_TOPIC=todos-processing

# =============================================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# =============================================================================
# Used for internal API calls and Pub/Sub push endpoint authentication
# INTEXURAOS_INTERNAL_AUTH_TOKEN is loaded from .envrc (synced from Secret Manager)

# =============================================================================
# GCP PROJECT
# =============================================================================
# Required by Google Cloud SDKs (Firestore, Pub/Sub, GCS).
export GOOGLE_CLOUD_PROJECT=intexuraos-dev-pbuchman
export INTEXURAOS_GCP_PROJECT_ID=intexuraos-dev-pbuchman

# =============================================================================
# ENCRYPTION (for LLM API key storage)
# =============================================================================
# AES-256 encryption key for LLM API keys. Already set in .envrc from Secret Manager.
# Only override here if you need a different key for local testing.

# =============================================================================
# WEB APP (Auth0 SPA Configuration)
# =============================================================================
# Required for web app authentication. These values should match your
# Auth0 SPA application configuration.
#
# Note: These are automatically loaded from .envrc (Secret Manager) but
# you can override them here for local development if needed.

# export INTEXURAOS_AUTH0_DOMAIN=your-tenant.eu.auth0.com
# export INTEXURAOS_AUTH0_SPA_CLIENT_ID=your-spa-client-id
# export INTEXURAOS_AUTH_AUDIENCE=urn:intexuraos:api

# =============================================================================
# OPTIONAL: Custom ports
# =============================================================================
# Override default ports if needed (e.g., port conflict).
# Default ports: user=8110, notion=8112, whatsapp=8113,
# mobile-notifications=8114, api-docs-hub=8115, research-agent=8116,
# web=3000

# export USER_SERVICE_PORT=9110

# =============================================================================
# PERSONAL IDENTIFIERS
# =============================================================================
# Used by Claude Code for sending WhatsApp messages and other personal actions
export INTEXURAOS_MY_PHONE_NUMBER=48534042325
export INTEXURAOS_USER_ID="google-oauth2|113131655542389277022"

# =============================================================================
# LOCAL WEB APP URL
# =============================================================================
# Used for redirect URIs in Auth0 SPA configuration during local development
export INTEXURAOS_WEB_APP_URL="http://localhost:3000"

# =============================================================================
# Goocle Calendar Integration (for local testing)
# =============================================================================
# Used by calendar-agent for Google Calendar API integration during local development
export INTEXURAOS_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8110/oauth/connections/google/callback

# =============================================================================
# SENTRY ERROR MONITORING
# =============================================================================
# Sentry DSN for error tracking in local development
# Default DSN for backend services
export INTEXURAOS_SENTRY_DSN="https://5e5f5df6749b5153e6692c7995ec3ff9@o4510702688337920.ingest.de.sentry.io/4510703655321680"
# Web app specific DSN
export INTEXURAOS_SENTRY_DSN_WEB="https://e80fca02a2e9ae3a49aeafcac1cf59fa@o4510702688337920.ingest.de.sentry.io/4510703657812048"
# Environment name for Sentry
export INTEXURAOS_ENVIRONMENT=development

# =============================================================================
# CODE-AGENT WORKER SETTINGS (for testing task dispatch)
# =============================================================================
# Worker credentials are stored per-user in Firestore, NOT as env vars.
# code-agent reads these from Firestore when dispatching tasks.
#
# To test task dispatch locally:
# 1. Configure worker settings via the IntexuraOS web UI or API
# 2. Each worker needs:
#    - name: e.g., "home-mac"
#    - url: Cloudflare Tunnel URL, e.g., "https://cc-mac.intexuraos.cloud"
#    - cfAccessClientId: Cloudflare Access service token client ID
#    - cfAccessClientSecret: Cloudflare Access service token secret
#    - dispatchSigningSecret: HMAC secret for request signing (see below)
#
# HMAC Signing (dispatchSigningSecret):
# This secret is used for secure communication between code-agent and orchestrator.
# - code-agent reads it from Firestore and signs outgoing dispatch requests
# - orchestrator reads INTEXURAOS_ORCHESTRATOR_SECRET from .envrc and verifies
# - BOTH SIDES MUST HAVE THE SAME SECRET
#
# Generate a secret: openssl rand -hex 32
# Then configure it in BOTH:
# 1. IntexuraOS worker settings (stored encrypted in Firestore)
# 2. .envrc via sync-secrets.sh (INTEXURAOS_ORCHESTRATOR_SECRET)
#
# See workers/orchestrator/README.md for full orchestrator setup instructions.

# =============================================================================
# PROJECT ID (for orchestrator Secret Manager access)
# =============================================================================
# Maps PROJECT_ID from .envrc to INTEXURAOS_PROJECT_ID for consistency
export INTEXURAOS_PROJECT_ID=$PROJECT_ID

# =============================================================================
# Orchestrator environments (for local testing)
# =============================================================================
# Repository URL for orchestrator (clones/fetches at startup)
export INTEXURAOS_REPOSITORY_URL=https://github.com/pbuchman/intexuraos.git
# Orchestrator's own repo clone (separate from dev worktrees)
export INTEXURAOS_REPOSITORY_PATH=$HOME/claude-orchestrator/intexuraos
export INTEXURAOS_CODE_AGENT_URL=http://localhost:8128
export INTEXURAOS_CHAT_AGENT_URL=http://localhost:8129
# Worker image reference for Claude containers (tag or digest)
# Recommended in production: immutable digest (@sha256:...)
# export INTEXURAOS_CLAUDE_WORKER_IMAGE=europe-central2-docker.pkg.dev/intexuraos-dev-pbuchman/intexuraos-dev/claude-worker@sha256:<digest>
# Preserve failed/interrupted containers for postmortem debugging (1=on, 0=off)
export INTEXURAOS_PRESERVE_FAILED_WORKER_CONTAINERS=1
# Only set if source vars are defined (preserves .envrc defaults otherwise)
[ -n "$ZAI_API_KEY" ] && export INTEXURAOS_ZAI_APP_API_KEY=$ZAI_API_KEY
[ -n "$GEMINI_APP_API_KEY" ] && export INTEXURAOS_GEMINI_APP_API_KEY=$GEMINI_APP_API_KEY
[ -n "$DASHSCOPE_API_KEY" ] && export INTEXURAOS_DASHSCOPE_APP_API_KEY=$DASHSCOPE_API_KEY
# OpenAI key for embeddings
[ -n "$OPENAI_API_KEY" ] && export INTEXURAOS_OPENAI_APP_API_KEY=$OPENAI_API_KEY
[ -n "$LINEAR_API_KEY" ] && export INTEXURAOS_LINEAR_API_KEY=$LINEAR_API_KEY
[ -n "$SENTRY_AUTH_TOKEN" ] && export INTEXURAOS_SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN

# GCP credentials for worker containers (needed for Firestore access inside containers)
export GOOGLE_APPLICATION_CREDENTIALS=$HOME/.config/gcloud/sa-key.json
