{
  "description": "Single source of truth for Cloud Run services whose URLs are injected into the web bundle at build time and for the matching local web/dev wiring. Consumed by apps/web/cloudbuild.yaml, .github/workflows/deploy.yml, apps/web/src/config.ts, apps/web/vite.config.ts, and ecosystem.config.cjs.",
  "services": [
