    "@intexuraos/infra-claude": "workspace:*",
    "@intexuraos/infra-firestore": "workspace:*",
    "@intexuraos/infra-gpt": "workspace:*",
    "@intexuraos/infra-openrouter": "workspace:*",
    "@intexuraos/infra-perplexity": "workspace:*",
    "@intexuraos/infra-sentry": "workspace:*",
    "@intexuraos/llm-contract": "workspace:*",
    "@intexuraos/llm-pricing": "workspace:*",
    "fastify": "catalog:",
    "firebase-admin": "^13.0.2",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "nock": "^14.0.0"
  }
