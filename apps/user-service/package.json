{
  "name": "@intexuraos/user-service",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-service.mjs user-service",
    "typecheck": "tsc --noEmit",
    "lint:local": "eslint src --max-warnings 0",
