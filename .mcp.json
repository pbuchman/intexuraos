{
  "mcpServers": {
    "linear": {
      "type": "sse",
      "url": "https://mcp.linear.app/sse",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      },
      "timeoutMs": 60000
    },
    "error_hub": {
      "command": "sh",
      "args": [
        "-lc",
        "exec sentry-mcp --access-token tailnet-only --host \"$ERROR_HUB_HOST\" --disable-skills=seer"
      ]
    }
  }
}
