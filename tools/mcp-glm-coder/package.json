{
  "name": "@intexuraos/mcp-glm-coder",
  "version": "0.1.0",
  "description": "MCP server for GLM-4.7 code generation with metrics tracking",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "glm-stats": "dist/cli/stats.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:server": "tsx watch src/index.ts --dev",
    "dev:proxy": "tsx src/proxy.ts",
    "start": "node dist/index.js",
    "stats": "node dist/cli/stats.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
