[Unit]
Description=IntexuraOS private Matrix integration
Requires=docker.service home-dev-matrix-mounts@adapter.service
After=docker.service home-dev-matrix-mounts@adapter.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/etc/intexuraos-matrix-sync
ExecStart=/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin /usr/bin/docker --host unix:///run/docker.sock compose --project-name intexuraos-matrix-sync --env-file /etc/intexuraos-matrix-sync/control.env -f /etc/intexuraos-matrix-sync/compose.yaml up --no-build --pull never --exit-code-from matrix-sync matrix-sync
ExecStop=/usr/bin/env -i HOME=/root PATH=/usr/bin:/bin /usr/bin/docker --host unix:///run/docker.sock compose --project-name intexuraos-matrix-sync --env-file /etc/intexuraos-matrix-sync/control.env -f /etc/intexuraos-matrix-sync/compose.yaml stop --timeout 30 matrix-sync
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
